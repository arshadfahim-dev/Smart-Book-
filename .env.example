# Smart Book Environment Configuration
# Copy this file to .env and replace placeholder values before running in production.

# Server port
PORT="3000"

# Runtime mode: development | production
NODE_ENV="development"

# Public URL where the application is hosted
APP_URL="http://localhost:3000"

# PostgreSQL connection string (for VPS & Docker database targets)
DATABASE_URL="postgresql://smartbook:YOUR_DB_PASSWORD@localhost:5432/smartbook"

# PostgreSQL password used by docker-compose.yml
POSTGRES_PASSWORD="YOUR_DB_PASSWORD"

# HMAC secret used to sign session tokens (replace with a random 32+ char string)
SESSION_SECRET="YOUR_RANDOM_32_CHAR_SESSION_SECRET"

# Optional initial admin bootstrap account (created at startup when configured)
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="YOUR_ADMIN_BOOTSTRAP_PASSWORD"

# Optional Gemini API key for server-side AI features
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional Vite HMR toggle for managed container previews (true | false)
DISABLE_HMR="false"
