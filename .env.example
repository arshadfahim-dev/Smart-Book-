# Smart Book Environment Configuration
# Copy this file to .env for local, VPS, or Docker deployments.

# Server port (default: 3000)
PORT=3000

# Runtime mode: development | production
NODE_ENV=development

# Public URL where the application is hosted
APP_URL="http://localhost:3000"

# PostgreSQL connection string (for VPS & Docker database targets)
DATABASE_URL="postgresql://smartbook:change_me@localhost:5432/smartbook"

# HMAC secret used to sign session tokens (set a random 32+ char string in production)
SESSION_SECRET=""

# Optional initial admin bootstrap account (created at startup when both are provided)
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Optional Gemini API key for server-side AI features
GEMINI_API_KEY=""
