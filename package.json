    "dotenv": "17.4.2",
    "express": "4.22.2",
    "firebase": "12.16.0",
    "lucide-react": "0.546.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.1",
    "recharts": "3.9.2",
